# Defaults: internal/campaign/config (setDefaults).
# Config file: app/configs/campaign.yaml (override path via CONFIG; campaign.prod.yaml for prod).
# This .env overrides both code defaults and config file values.
# Flags override this .env.

# CONFIG=app/configs/campaign.yaml

# CAMPAIGN_DB_POOL_URI=postgres://user:password@localhost:5432/campaign?sslmode=disable

# CAMPAIGN_SERVER_ADDRESS=127.0.0.1:8080
# CAMPAIGN_SERVER_SHUTDOWN_TIMEOUT=10s
# CAMPAIGN_LOGGER_LEVEL=info
# CAMPAIGN_LOGGER_FORMAT=json

# CAMPAIGN_SERVER_CERT_FILE=certs/server.crt
# CAMPAIGN_SERVER_KEY_FILE=certs/server.key
