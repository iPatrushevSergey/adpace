# Docker Compose — copy to repo root: cp .env.example .env
# docker compose reads .env automatically; do not commit .env.

# PostgreSQL
POSTGRES_USER=campaign
POSTGRES_PASSWORD=campaign
POSTGRES_DB=campaign
CAMPAIGN_DB_POOL_URI=postgres://campaign:campaign@localhost:5432/campaign?sslmode=disable

# App (campaign-manager) — non-secret defaults
CAMPAIGN_SERVER_ADDRESS=0.0.0.0:8080
